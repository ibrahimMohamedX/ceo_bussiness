# ==============================================================================
# PROJEX — Firebase environment variable template
# ------------------------------------------------------------------------------
# COPY THIS FILE to `.env.local` (or your platform's env store) and fill in
# real values. NEVER commit real values. The names here are placeholders only.
#
# Public web config below MAY be prefixed NEXT_PUBLIC_* because it is the
# browser-safe Firebase web-app configuration (per architecture doc 07).
# Server/admin credentials MUST NEVER be exposed to the client bundle.
# ==============================================================================

# ▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀
# CLIENT-SAFE — browser Firebase web config (required)
# From Firebase Console → Project settings → General → Your apps → Web app.
# These values ship to the browser by design (they are not secrets).
# ▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional: NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID for Firebase Analytics.

# ▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀
# SERVER-ONLY — Firebase Admin SDK (required for admin/server paths)
# From Firebase Console → Project settings → Service accounts →
# "Generate new private key". Download the JSON, keep it OUT of the repo,
# and paste the values below. These are server credentials — NEVER in
# NEXT_PUBLIC_* or in any code bundled for the browser.
# ▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀
# PROJECT_ID reused by the Admin SDK (same as the client project ID above).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# The private key contains literal \n sequences. Keep the quotes so the \n stays put.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Storage bucket name (e.g. "projex-xxxxx.appspot.com"). Used by Admin Storage.
FIREBASE_STORAGE_BUCKET=
CLOUDINARY_CLOUD_NAME=mhx5jwdf
CLOUDINARY_API_KEY=264582145892286
CLOUDINARY_API_SECRET=Fh6Gj69RQekOz0CYItZVMusyjmA
# Same cloud name as above, exposed to the browser for delivery-URL construction.
# Delivery URLs are public and need no credentials; the API key/secret above stay
# server-only and must never be given a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=mhx5jwdf